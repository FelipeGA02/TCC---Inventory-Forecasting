digraph UC {
  rankdir=LR; nodesep=0.28; ranksep=1.5; pad=0.2;
  node [fontname="Arial", fontsize=13];
  edge [color="#555555", arrowsize=0.9, penwidth=1.2];
  node [shape=plaintext];
  adm [label="Gestora de compras\n(administrador)"];
  con [label="Gerente de operações\n(consulta)"];
  node [shape=ellipse, style=filled, fillcolor="#e8f1fb", color="#2e75b6", width=2.7, height=0.8];
  up  [label="Enviar planilha\nde vendas", fillcolor="#fbeee8", color="#b6662e"];
  tr  [label="Treinar previsões", fillcolor="#fbeee8", color="#b6662e"];
  ana [label="Consultar análises\nde vendas"];
  prev [label="Consultar previsão diária\n(14 dias)"];
  hist [label="Consultar histórico\nda previsão"];
  conf [label="Conferir vendas\nimportadas"];
  noti [label="Receber notificações"];
  exp [label="Exportar relatórios\n(CSV / Excel / PDF)"];
  node [fillcolor="#eaf7ea", color="#3e8e41"];
  ver [label="Conferir planilha\nantes de gravar"];
  val [label="Validar e treinar\ncada série"];
  adm -> up; adm -> tr; adm -> ana; adm -> prev; adm -> hist; adm -> conf; adm -> noti; adm -> exp;
  con -> ana; con -> prev; con -> hist; con -> conf; con -> noti; con -> exp;
  edge [style=dashed, color="#999999", fontcolor="#888888", fontsize=10, fontname="Arial"];
  up -> ver [label="«include»"];
  tr -> val [label="«include»"];
  {rank=same; ver; val;}
}
