digraph ACT {
  rankdir=TB; nodesep=0.55; ranksep=0.36; pad=0.2;
  node [fontname="Arial", fontsize=13, shape=box, style="rounded,filled", fillcolor="#e8f0fb", color="#2e75b6", width=3.5, height=0.55];
  edge [color="#555555", arrowsize=0.9, penwidth=1.2, fontname="Arial", fontsize=11];
  ini [shape=circle, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#000000", color="#2e75b6"];
  env [label="Enviar planilha de vendas (XLSX)"];
  cnf [label="Conferir sem gravar: período por loja,\nvendas novas e já carregadas,\ndias de loja aberta sem venda"];
  ok  [shape=diamond, label="Gestora\nconfirma?", style=filled, fillcolor="#fff6dd", color="#c9a227", width=2.0, height=1.0];
  cnc [label="Cancelar envio", fillcolor="#fbeee8", color="#b6662e", width=2.0];
  grv [label="Gravar vendas novas, marcar encomendas\ngrandes e registrar a planilha"];
  trn [label="Solicitar treino das previsões"];
  mud [shape=diamond, label="Dados mudaram\ndesde o último\ntreino?", style=filled, fillcolor="#fff6dd", color="#c9a227", width=2.2, height=1.2];
  skp [label="Registrar treino\ncomo dispensado", fillcolor="#fbeee8", color="#b6662e", width=2.2];
  ser [label="Montar séries diárias por loja: 4 categorias\ne produtos de grama (sem encomendas grandes)"];
  suf [shape=diamond, label="Histórico\nsuficiente?", style=filled, fillcolor="#fff6dd", color="#c9a227", width=2.0, height=1.0];
  ins [label="Registrar série sem\nprevisão e o motivo", fillcolor="#fbeee8", color="#b6662e", width=2.2];
  aic [label="Para d = 0 e d = 1: selecionar a ordem
do SARIMAX pelo AIC"];
  wf  [label="Para d = 0 e d = 1: validar em walk-forward\n(56 origens, horizonte de 14 dias)"];
  met [label="Manter o d de menor erro e calcular as métricas:
MASE, erro relativo,
cobertura e largura do intervalo de 95%"];
  fin [label="Ajustar nos últimos 545 dias e prever os 91 dias\nseguintes (intervalo de 95%) e aplicar o\nfator das datas comemorativas"];
  gh  [label="Gravar previsões, histórico congelado\ne registro do treino"];
  tel [label="Exibir previsão, histórico e relatórios"];
  fim [shape=doublecircle, label="", width=0.26, height=0.26, fixedsize=true, style=filled, fillcolor="#000000", color="#000000"];
  ini -> env -> cnf -> ok;
  ok -> grv [label=" sim"];
  ok -> cnc [label=" não"];
  grv -> trn -> mud;
  mud -> ser [label=" sim"];
  mud -> skp [label=" não"];
  ser -> suf;
  suf -> aic [label=" sim"];
  suf -> ins [label=" não"];
  aic -> wf -> met -> fin;
  fin -> gh; ins -> gh [constraint=false];
  gh -> tel -> fim;
  {rank=same; grv; cnc;}
  {rank=same; ser; skp;}
  {rank=same; aic; ins;}
}
