digraph CLS {
  rankdir=TB; nodesep=0.5; ranksep=0.6; newrank=true; pad=0.2;
  node [shape=plaintext, fontname="Arial", fontsize=12];
  edge [color="#555555", arrowsize=0.8, penwidth=1.0, fontname="Arial", fontsize=10];
  usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>Usuario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- email<BR/>- nome<BR/>- perfil</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ autenticar()</TD></TR></TABLE>>];
  planilha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>Planilha</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- arquivo<BR/>- hashSHA256<BR/>- linhasNovas<BR/>- linhasDuplicadas<BR/>- diasSemVenda</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ conferir()<BR/>+ gravar()</TD></TR></TABLE>>];
  loja [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>Loja</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id<BR/>- nome<BR/>- cidade</TD></TR></TABLE>>];
  calendario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>DiaCalendario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dia<BR/>- lojaFechada<BR/>- aberturaExcepcional<BR/>- feriado</TD></TR></TABLE>>];
  venda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>Venda</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- data<BR/>- documento<BR/>- quantidade<BR/>- valor<BR/>- encomendaGrande</TD></TR></TABLE>>];
  produto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>Produto</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- codigo<BR/>- nome<BR/>- subcategoria</TD></TR></TABLE>>];
  categoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>Categoria</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id<BR/>- nome</TD></TR></TABLE>>];
  serie [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>SerieDiaria</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- loja<BR/>- nivel (categoria | produto)<BR/>- item<BR/>- quantidades[]</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ montar()</TD></TR></TABLE>>];
  treino [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>Treino</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- status<BR/>- impressaoDigital<BR/>- dadosAte<BR/>- configuracao</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ executar()</TD></TR></TABLE>>];
  modelo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>ModeloSerie</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ordem(p,d,q)<BR/>- ordemSazonal<BR/>- aic<BR/>- mase<BR/>- cobertura<BR/>- coeficientes</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ selecionarOrdem()<BR/>+ validarWalkForward()<BR/>+ prever()</TD></TR></TABLE>>];
  previsao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>PrevisaoDiaria</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- data<BR/>- previsto<BR/>- limiteInferior<BR/>- limiteSuperior</TD></TR></TABLE>>];
  historico [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>PontoHistorico</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dia<BR/>- previsto<BR/>- dataOrigem<BR/>- fonte<BR/>- lojaFechada</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ congelar()</TD></TR></TABLE>>];
  relatorio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f4f8fd" COLOR="#8ab2d7"><TR><TD><B>Relatorio</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tipo<BR/>- formato</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ exportar()</TD></TR></TABLE>>];
  usuario -> planilha [label=" envia"];
  planilha -> venda [label=" origina"];
  venda -> loja;
  venda -> produto;
  produto -> categoria;
  loja -> calendario [arrowhead=none, arrowtail=diamond, dir=back, label=" 1..*"];
  venda -> serie [label=" agrega"];
  calendario -> serie [style=dashed, arrowhead=open, label=" exógenas"];
  usuario -> treino [label=" solicita"];
  treino -> modelo [arrowhead=none, arrowtail=diamond, dir=back, label=" 1..*"];
  serie -> modelo [label=" alimenta"];
  modelo -> previsao [label=" gera"];
  previsao -> historico [label=" congela"];
  previsao -> relatorio;
  historico -> relatorio;
  {rank=same; usuario; planilha; venda; loja;}
  {rank=same; treino; categoria; produto; serie; calendario;}
  {rank=same; previsao; historico; relatorio;}
}
