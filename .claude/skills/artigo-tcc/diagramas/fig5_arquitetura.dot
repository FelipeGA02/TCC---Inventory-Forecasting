digraph ARQ {
  rankdir=TB; nodesep=0.35; ranksep=0.42; pad=0.2; compound=true;
  node [fontname="Arial", fontsize=12, shape=box, style="rounded,filled"];
  edge [color="#555555", arrowsize=0.9, penwidth=1.2, fontname="Arial", fontsize=10];
  subgraph cluster_ing { label="Camada de Ingestão"; fontname="Arial"; fontsize=14; labeljust="l"; style="rounded,filled"; fillcolor="#f4f7fc"; color="#2e75b6";
    i1 [label="Envio de planilhas de vendas (XLSX)\ne conferência antes de gravar", fillcolor="#e8f0fb", color="#2e75b6"];
    i2 [label="Registro da planilha (SHA-256)\ne base de vendas deduplicada", fillcolor="#e8f0fb", color="#2e75b6"];
    i1 -> i2; }
  subgraph cluster_proc { label="Camada de Processamento"; fontname="Arial"; fontsize=14; labeljust="l"; style="rounded,filled"; fillcolor="#eef8ef"; color="#3e8e41";
    p1 [label="Extração, padronização e\nclassificação dos produtos\n(pandas, numpy)", fillcolor="#eaf7ea", color="#3e8e41"];
    p2 [label="Encomendas grandes, calendário\npor loja e séries diárias", fillcolor="#eaf7ea", color="#3e8e41"];
    p1 -> p2; }
  subgraph cluster_mod { label="Camada de Modelagem (serviço de previsão)"; fontname="Arial"; fontsize=14; labeljust="l"; style="rounded,filled"; fillcolor="#fbf0ec"; color="#b6662e";
    m1 [label="SARIMAX por categoria e por\nproduto de grama, em cada loja\n(statsmodels, ordem pelo AIC e d pela validação)", fillcolor="#fbeee8", color="#b6662e"];
    m2 [label="Validação walk-forward\n(MASE, cobertura do intervalo de 95%)", fillcolor="#fbeee8", color="#b6662e"];
    m3 [label="Previsão de 91 dias, fator das datas\ne histórico congelado", fillcolor="#fbeee8", color="#b6662e"];
    m1 -> m2 -> m3; }
  subgraph cluster_apr { label="Camada de Apresentação"; fontname="Arial"; fontsize=14; labeljust="l"; style="rounded,filled"; fillcolor="#f6f0fc"; color="#7a5ab5";
    a0 [label="API REST\n(FastAPI, autenticação JWT)", fillcolor="#efe6fb", color="#7a5ab5"];
    a1 [label="Painel interativo (React):\nanálises, previsão e histórico", fillcolor="#efe6fb", color="#7a5ab5"];
    a3 [label="Exportação de relatórios\n(CSV / Excel / PDF)", fillcolor="#efe6fb", color="#7a5ab5"];
    a0 -> a1 -> a3; }
  db [label="Banco de dados relacional:\nPostgreSQL (Neon) ou SQLite\n(SQLAlchemy)", shape=cylinder, style=filled, fillcolor="#fff6dd", color="#c9a227"];
  i2 -> p1 [label=" vendas"];
  p2 -> m1 [label=" séries e calendário"];
  m3 -> a0 [label=" previsões"];
  i2 -> db [style=dashed, arrowhead=open, constraint=false];
  m3 -> db [style=dashed, arrowhead=open, constraint=false];
}
