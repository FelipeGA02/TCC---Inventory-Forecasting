# Copie para deploy/.env no servidor e preencha. NUNCA versione o deploy/.env.

# Endereço público da API (aponta para o IP do servidor), ex.: verdeperto-api.duckdns.org
API_DOMINIO=

# Banco: a mesma URL do Neon do ia-predictor/.env (região São Paulo, endpoint -pooler)
DATABASE_URL=

# Auth: os mesmos valores do ia-predictor/.env (outra chave JWT derruba as sessões abertas)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=gestora@floricultura.com
ADMIN_PASSWORD=
VIEWER_EMAIL=gerente@floricultura.com
VIEWER_PASSWORD=

# Endereço do front na Vercel (lista JSON), ex.: ["https://verde-perto.vercel.app"]
CORS_ORIGINS=[]

# Treino: um processo por CPU da máquina (Always Free: 4 OCPUs)
TRAINING_WORKERS=4
RETRAIN_DAY_OF_WEEK=mon
RETRAIN_HOUR=2
RETRAIN_AFTER_UPLOAD_MINUTES=10
