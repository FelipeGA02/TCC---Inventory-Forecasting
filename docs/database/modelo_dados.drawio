"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7F7F7F;fontColor=#7F7F7F;startArrow=ERmandOne;" edge="1" parent="1" source="t_forecast_jobs_r0" target="t_forecast_job_logs_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7F7F7F;fontColor=#7F7F7F;startArrow=ERmandOne;" edge="1" parent="1" source="t_forecast_jobs_r0" target="t_series_models_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7F7F7F;fontColor=#7F7F7F;startArrow=ERmandOne;" edge="1" parent="1" source="t_units_r0" target="t_series_models_r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7F7F7F;fontColor=#7F7F7F;startArrow=ERzeroToOne;" edge="1" parent="1" source="t_categories_r0" target="t_series_models_r4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7F7F7F;fontColor=#7F7F7F;startArrow=ERzeroToOne;" edge="1" parent="1" source="t_products_r0" target="t_series_models_r5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7F7F7F;fontColor=#7F7F7F;startArrow=ERmandOne;" edge="1" parent="1" source="t_series_models_r0" target="t_series_forecasts_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7F7F7F;fontColor=#7F7F7F;startArrow=ERmandOne;" edge="1" parent="1" source="t_series_models_r0" target="t_series_backtest_points_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7F7F7F;fontColor=#7F7F7F;startArrow=ERmandOne;" edge="1" parent="1" source="t_units_r0" target="t_forecast_history_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7F7F7F;fontColor=#7F7F7F;startArrow=ERzeroToOne;" edge="1" parent="1" source="t_forecast_jobs_r0" target="t_forecast_history_r10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g0" value="Acesso e cargas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="-30" width="446" height="40" as="geometry"/></mxCell><mxCell id="g1" value="Vendas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="640" y="-30" width="446" height="40" as="geometry"/></mxCell><mxCell id="g2" value="Catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1240" y="-30" width="446" height="40" as="geometry"/></mxCell><mxCell id="g3" value="Previsão (categorias e grama, ADR-017)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1840" y="-30" width="1646" height="40" as="geometry"/></mxCell><mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;PK = chave primária (sublinhada) · FK = chave estrangeira · UQ = único&lt;br&gt;NULL = coluna aceita nulo · texto após o tipo = valores aceitos&lt;br&gt;─┤├──&amp;lt; : 1 para N (FK obrigatória) · ─o┤──&amp;lt; : 0..1 para N (FK opcional)&lt;br&gt;&lt;br&gt;&lt;b&gt;Índices compostos&lt;/b&gt;&lt;br&gt;sales: índice (document_number, product_code, sale_date, quantity, gross_amount)&lt;br&gt;sales: índice (unit_id, sale_date)&lt;br&gt;series_models: índice (job_id, unit_id)&lt;br&gt;forecast_history: UNIQUE (unit_id, level, item, day)&lt;br&gt;&lt;br&gt;&lt;b&gt;Exclusão em cascata&lt;/b&gt;&lt;br&gt;processing_log.forecast_job_id → forecast_jobs: ON DELETE SET NULL&lt;br&gt;forecast_job_logs.job_id → forecast_jobs: ON DELETE CASCADE&lt;br&gt;series_models.job_id → forecast_jobs: ON DELETE CASCADE&lt;br&gt;series_forecasts.model_id → series_models: ON DELETE CASCADE&lt;br&gt;series_backtest_points.model_id → series_models: ON DELETE CASCADE&lt;br&gt;forecast_history.job_id → forecast_jobs: ON DELETE SET NULL&lt;br&gt;&lt;br&gt;&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;A planilha enviada não é guardada: os campos usados vão para sales e&lt;br&gt;processing_log guarda nome, SHA-256 e o resultado da carga.&lt;br&gt;sales não guarda nome de cliente, vendedor ou operador (LGPD).&lt;br&gt;Resumos por loja, categoria e produto são calculados de sales (não gravados).&lt;br&gt;params e metrics de model_artifacts são JSON (ver docstring do ORM).&lt;br&gt;O painel lê os próximos 14 dias da última forecast_runs com status = done&lt;br&gt;(gerada ao fim de cada treino e quando calendar_days muda depois dele)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="760" width="506" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>