# Banco
# Local: SQLite. Banco compartilhado: a URL do console do Neon (Connect → Connection string).
DATABASE_URL=sqlite:///./floricultura.db
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Diretórios
DATA_DIR=data
MODELS_DIR=models

# Auth (configure antes do primeiro boot)
JWT_SECRET_KEY=troque_por_string_aleatoria_32_chars_minimo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7

# Usuários iniciais
ADMIN_EMAIL=gestora@floricultura.com
ADMIN_PASSWORD=troque_por_senha_forte
VIEWER_EMAIL=gerente@floricultura.com
VIEWER_PASSWORD=troque_por_senha_forte

# Pipeline ML
TOP_N_PRODUCTS=20
LOG_CV_THRESHOLD=0.7
TRAINING_WORKERS=8          # processos no treino (no servidor: o nº de CPUs)

# Scheduler
RETRAIN_DAY_OF_WEEK=mon
RETRAIN_HOUR=2
RETRAIN_AFTER_UPLOAD_MINUTES=10
# local (treino na própria API) ou externo (a API não treina — Render, ver deploy/README.md)
TRAINING_RUNNER=local
