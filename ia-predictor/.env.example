# Banco
# Local: SQLite. Banco compartilhado: a URL do console do Neon (Connect → Connection string).
DATABASE_URL=sqlite:///./floricultura.db
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Diretórios
DATA_DIR=data
MODELS_DIR=models

# Auth — a API não sobe com estes valores de exemplo: troque a chave (32+ caracteres,
# ex.: python -c "import secrets; print(secrets.token_hex(32))") e as duas senhas (8+)
JWT_SECRET_KEY=troque_por_string_aleatoria_32_chars_minimo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7

# Usuários iniciais
ADMIN_EMAIL=gestora@floricultura.com
ADMIN_PASSWORD=troque_por_senha_forte
VIEWER_EMAIL=gerente@floricultura.com
VIEWER_PASSWORD=troque_por_senha_forte

# /docs, /redoc e /openapi.json (o render.yaml desliga na API publicada)
DOCS_ENABLED=true

# Previsão (ADR-017): categorias e produtos de grama, por loja
FORECAST_HORIZON_DAYS=14            # walk-forward (teste de acerto)
FORECAST_MAX_HORIZON_DAYS=91        # dias previstos; a tela escolhe de 14 a 91 (ADR-021)
FORECAST_SERVICE_D_CANDIDATES=[0,1]  # d testados no walk-forward de cada série; fica o que errou menos (ADR-020)
FORECAST_SERVICE_WINDOW_DAYS=365
FORECAST_SERVICE_WF_ORIGINS=56
FORECAST_SERVICE_MIN_SALE_DAYS=28
FORECAST_SERVICE_KEEP_BACKTEST_JOBS=4   # treinos que guardam o walk-forward inteiro
FORECAST_SERVICE_EVENT_FACTOR=true      # fator das datas comemorativas em Flores de corte (ADR-019)
TRAINING_WORKERS=8          # processos no treino (no servidor: o nº de CPUs; proot/Termux: 1)
# local (botão "Treinar previsões" na própria API) ou externo (a API não treina:
# python -m backend.scripts.treinar_previsoes em outra máquina — Render, ver deploy/README.md)
TRAINING_RUNNER=local
